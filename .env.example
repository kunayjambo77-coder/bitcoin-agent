# Copy to .env locally, or set these in your host's dashboard. NEVER commit real values.
PORT=3000

# From the Agent Games dashboard after registering the agent (Rotate Secret).
HMAC_SECRET=

# API key issued for this agent at registration (used for /api/vfy/* calls).
AGENT_API_KEY=

# Platform API base (default https://agentgames.zkverify.io)
PLATFORM_API_BASE=https://agentgames.zkverify.io

# 1 = reject tasks whose incoming x-agent-games-signature does not verify (enable after HMAC_SECRET is set).
REQUIRE_INCOMING_SIG=0

# 1 = an APPROVE that cannot produce a finalized proof degrades to REJECT (fail closed).
STRICT_PROOF=0

# Registered gatekeeper verification-key hash (from /api/circuit-info).
GATEKEEPER_VK_HASH=0x6b79c6012a6d8651f3e13bc4d2a20370280ab49700c90c5316d4168bfbad77b0

# JSON map of gatekeeper circuit input signals -> task fields, e.g.
# {"amount":"amount","minimum":"minimum","publicBalance":"publicBalance"}
GATEKEEPER_INPUT_MAP=
